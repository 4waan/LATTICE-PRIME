# Copy to agent/secrets/private-trading.env with mode 0600.
# Use a dedicated funded ECDSA relayer key. Never reuse an administrator,
# issuer, operator, or connected-wallet key.
PRIVATE_TRADING_RELAYER_KEY=0xREPLACE_WITH_DEDICATED_RELAYER_KEY

PRIVATE_TRADING_ALLOWED_ORIGIN=https://market.example
PRIVATE_TRADING_HTTP_HOST=0.0.0.0
PRIVATE_TRADING_HTTP_PORT=8787
PRIVATE_TRADING_RATE_LIMIT=60
PRIVATE_TRADING_RATE_WINDOW_MS=60000
PRIVATE_TRADING_REQUEST_TIMEOUT_MS=15000

PRIVATE_TRADING_STATE_DIR=/state
PRIVATE_TRADING_RPC_URL=https://testnet.hashio.io/api
PRIVATE_TRADING_ENGINE_ADDRESS=0xREPLACE
PRIVATE_TRADING_FACTORY_ADDRESS=0xREPLACE
PRIVATE_TRADING_GATE_ADDRESS=0xREPLACE
PRIVATE_TRADING_REGISTRY_ADDRESS=0xREPLACE
PRIVATE_TRADING_SECURITY_ADDRESS=0xREPLACE
PRIVATE_TRADING_RECOVERY_ROUTER_ADDRESS=0xREPLACE
PRIVATE_TRADING_HBAR_POOL_ADDRESS=0xREPLACE
PRIVATE_TRADING_LPRC_POOL_ADDRESS=0xREPLACE
PRIVATE_TRADING_PARTITION=0xREPLACE
PRIVATE_TRADING_QUICKNET_CHAIN_HASH=0x52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
PRIVATE_TRADING_SESSION_CREATION_CODE_HASH=0xREPLACE
PRIVATE_TRADING_GENERATION=1
PRIVATE_TRADING_FEE_POLICY_DIGEST=0xREPLACE
PRIVATE_TRADING_HBAR_DENOMINATION_TINYBAR=100000000
PRIVATE_TRADING_LPRC_DENOMINATION=1

PRIVATE_TRADING_TICKETS_BASE=/api/private/tickets
PRIVATE_TRADING_ORDERS_BASE=/api/private/orders
PRIVATE_TRADING_ROUTING_PATH=/api/private/routing
PRIVATE_TRADING_SESSIONS_PATH=/api/private/sessions

# This reserve remains untouched after covering the fixed gas envelope.
PRIVATE_TRADING_MAX_GAS_PRICE_WEI=REPLACE_WITH_POLICY_CAP
PRIVATE_TRADING_RELAYER_RESERVE_WEI=REPLACE_WITH_RESERVE
PRIVATE_TRADING_DEPLOY_AND_REGISTER_GAS_LIMIT=5500000
PRIVATE_TRADING_REGISTER_GAS_LIMIT=4000000
PRIVATE_TRADING_RECOVERY_GAS_LIMIT=4500000
PRIVATE_TRADING_WORKER_INTERVAL_MS=3000
PRIVATE_TRADING_CONFIRMATIONS=1
PRIVATE_TRADING_TRANSACTION_TIMEOUT_MS=120000
