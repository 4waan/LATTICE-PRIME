# Where the relay stopped, per contract. Runtime state, not evidence: every
# published record carries tx and log index, so a consumer dedupes without it,
# and tools/hcs-relay.mjs reads the topic back at startup anyway.
deployments/hcs-cursor.json

# Raw cast output from script/live/rename-bond.sh. The evidence that matters is
# the `renamed` block in deployments/296-venue.json, which carries both hashes.
deployments/.rename-bond/

# Private-agent proving products and local state. Manifests and evidence reports
# are tracked; keys, witnesses, proofs, tickets, and runtime journals are not.
agent/artifacts/
agent/state/

# The synthetic bot population: runner, job configs, journals. Kept local.
bots/

# Oracle publisher durability and per-process secret injection.
oracle/state/
oracle/secrets/
oracle/config.json
