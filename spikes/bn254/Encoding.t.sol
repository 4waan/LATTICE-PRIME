pragma solidity ^0.8.20;
import "../src/PrecompileProbe.sol";

contract EncodingTest {
    PrecompileProbe probe;
    function setUp() public { probe = new PrecompileProbe(); }

    /// The bytes on the right are exactly what was sent to Hedera testnet,
    /// previewnet and mainnet by eth_call and returned 1.
    function test_bilinear2_calldata_is_what_hedera_answered() public view {
        require(keccak256(probe.exposePairInput2()) == keccak256(hex""), "bil2 mismatch");
    }
    function test_bilinear3_calldata_is_what_hedera_answered() public view {
        require(keccak256(probe.exposePairInput3()) == keccak256(hex""), "bil3 mismatch");
    }
    /// Negative control: the test must be capable of failing.
    function test_mutated_input_does_not_match() public view {
        bytes memory good = probe.exposePairInput2();
        good[100] = bytes1(uint8(good[100]) ^ 0x01);
        require(keccak256(good) != keccak256(hex""), "mutation went undetected");
    }
}
